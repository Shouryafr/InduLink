# InduLink configuration. Copy to .env and export it before running, or set the
# same names in your shell / process manager. Never commit a real secret.
#
#   set -a; . ./.env; set +a        (bash/zsh)
#   $env:SECRET_KEY = "..."         (PowerShell)

APP_ENV=development

# Required in production (>= 32 characters). Signs CSRF tokens. Development
# generates an ephemeral key, so sessions do not survive a restart.
SECRET_KEY=

# Defaults to var/indulink.db (SQLite, WAL, foreign keys on).
# DATABASE_URL=sqlite+pysqlite:///var/indulink.db

# Demo mode shows the synthetic sign-in table on the sign-in page and labels
# every seeded record as synthetic. Turn it off for a real deployment.
DEMO_MODE=true

# Secure cookies are forced on when APP_ENV=production.
# COOKIE_SECURE=true

# bcrypt cost. Production refuses anything below 12.
BCRYPT_ROUNDS=12

# Session and sign-in throttling.
SESSION_IDLE_HOURS=720
SESSION_ABSOLUTE_HOURS=720
SIGNIN_MAX_ATTEMPTS=5
SIGNIN_LOCKOUT_MINUTES=15

# Data freshness windows used by the availability and evidence badges.
AVAILABILITY_FRESHNESS_DAYS=30
EVIDENCE_REVIEW_SLA_DAYS=14
